---
import Base from '../layouts/Base.astro';
import LandingFooter from './LandingFooter';
import LandingHeader from './LandingHeader';
import LandingMain from './LandingMain';
import {
  WINGET_COMMAND,
  type LandingCopy,
} from '../lib/lpContent';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${new URL(copy.canonicalPath, Astro.site)}#faq`,
  inLanguage: copy.lang,
  mainEntity: copy.faq.items.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<Base
  title={copy.title}
  description={copy.description}
  ogDescription={copy.ogDescription}
  lang={copy.lang}
  canonicalPath={copy.canonicalPath}
>
  <LandingHeader copy={copy} />

  <LandingMain copy={copy} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd).replace(/</g, '\\u003c')} />

  <script define:vars={{ command: WINGET_COMMAND }}>
    {
      // Inline styles, not Tailwind utility classes — classes added via
      // classList from a script aren't visible to Tailwind's build-time
      // scanner, so they'd never get generated CSS.
      const pill = document.getElementById('winget-pill');
      const button = document.getElementById('winget-copy');
      const label = document.getElementById('winget-copy-label');
      let resetTimer;
      button?.addEventListener('click', async () => {
        await navigator.clipboard.writeText(command);
        window.gtag?.('event', 'winget_copy_click');
        const copied = button.dataset.copiedLabel ?? 'Copied!';
        const original = button.dataset.copyLabel ?? label?.textContent ?? '';
        if (label) label.textContent = copied;
        if (label) label.style.color = 'var(--color-accent)';
        if (pill) pill.style.borderColor = 'var(--color-accent)';
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          if (label) label.textContent = original;
          if (label) label.style.color = '';
          if (pill) pill.style.borderColor = '';
        }, 1500);
      });
    }
  </script>

  <script>
    {
      const track = document.getElementById('carousel-track');
      const dots = [document.getElementById('dot-0'), document.getElementById('dot-1'), document.getElementById('dot-2')];
      const prevBtn = document.getElementById('carousel-prev');
      const nextBtn = document.getElementById('carousel-next');
      const video = document.getElementById('carousel-video') as HTMLVideoElement | null;
      const VIDEO_SLIDE = 0;
      let current = 0;
      let timer: ReturnType<typeof setInterval>;

      function goTo(i: number) {
        current = i;
        (track as HTMLElement).style.transform = `translateX(-${i * 100}%)`;
        dots.forEach((d, j) => {
          (d as HTMLElement).style.background = j === i ? 'var(--color-accent)' : 'var(--color-muted)';
          (d as HTMLElement).style.opacity = j === i ? '1' : '0.4';
        });
        if (video) {
          if (i === VIDEO_SLIDE) {
            video.currentTime = 0;
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      }

      // The video slide advances itself when playback finishes (it's
      // ~20s, far longer than the 5s image interval); the other slides
      // still advance on a fixed timer.
      video?.addEventListener('ended', () => {
        if (current === VIDEO_SLIDE) restart((current + 1) % dots.length);
      });

      function startAuto() {
        timer = setInterval(() => {
          if (current === VIDEO_SLIDE) return;
          goTo((current + 1) % dots.length);
        }, 5000);
      }

      function restart(i: number) {
        clearInterval(timer);
        goTo(i);
        startAuto();
      }

      dots.forEach((d, i) => d?.addEventListener('click', () => restart(i)));
      prevBtn?.addEventListener('click', () => restart((current - 1 + dots.length) % dots.length));
      nextBtn?.addEventListener('click', () => restart((current + 1) % dots.length));

      const SWIPE_THRESHOLD_PX = 40;
      let touchStartX = 0;

      track?.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
      }, { passive: true });

      track?.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) < SWIPE_THRESHOLD_PX) return;
        if (dx < 0) restart((current + 1) % dots.length);
        else restart((current - 1 + dots.length) % dots.length);
      }, { passive: true });

      startAuto();
    }
  </script>

  <LandingFooter copy={copy} />

  <script>
    const track = (id: string, event: string) => {
      document.getElementById(id)?.addEventListener('click', () => {
        window.gtag?.('event', event);
      });
    };
    track('nav-download', 'download_click');
    track('hero-download', 'download_click');
    track('nav-github', 'github_link_click');
    track('hero-github', 'github_link_click');
    track('footer-github', 'github_link_click');

    document.getElementById('lang-select')?.addEventListener('change', (e) => {
      const path = (e.target as HTMLSelectElement).value;
      if (path) window.location.href = path;
    });
  </script>
</Base>
